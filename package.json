    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:build-policy": "node scripts/check-build-policy.mjs",
    "test": "node scripts/generate.mjs && vitest run",
    "test:watch": "node scripts/generate.mjs && vitest",
    "gate:0": "vitest run --config vitest.gate.config.ts",
    "check": "node scripts/check.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:shell": "node scripts/dev.mjs shell",
    "dev:remotes": "node scripts/dev.mjs remotes",
    "dev:discovery": "node scripts/dev.mjs discovery",
    "dev:geology": "node scripts/dev.mjs geology",
    "build:test-apps": "node scripts/build-test-apps.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@company/eslint-plugin-mfe": "workspace:*",
    "@company/mfe-core": "workspace:*",

    "@company/mfe-react": "workspace:*",
    "@company/mfe-rsbuild": "workspace:*",
    "@module-federation/enhanced": "2.9.0",
    "@module-federation/rsbuild-plugin": "2.9.0",
    "@playwright/test": "1.63.0",
    "@rsbuild/core": "2.2.8",
    "@rsbuild/plugin-babel": "2.1.0",
    "@rsbuild/plugin-react": "2.1.0",
    "@rspack/core": "2.2.6",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/history": "1.162.4",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/router-generator": "1.167.38",
    "@tanstack/router-plugin": "1.168.40",
    "@tecton/react": "file:vendor/tecton-react",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "babel-loader": "10.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.10.0",
